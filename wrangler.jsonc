{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mind",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",

  // Frontend and API served from the same origin, so the client calls "/api/chat"
  // and there is no CORS to get wrong.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Workers AI needs no key and no id — this binding alone gives us
  // whisper, melotts, aura and the clef decision ladder.
  "ai": {
    "binding": "AI"
  },

  // Already exists in this account (r2-explorer-bucket). Enabling it turns on
  // /api/upload, /f/:id and the TTS mp3 cache.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "r2-explorer-bucket"
    }
  ],

  // Bound to match the deployment, and so /api/health can report reachability.
  // Nothing calls these yet: ORPROXY speaks the older ai_ncards_format surface
  // (/api/openrouter), and no route needs AGENT-BROWSING.
  "services": [
    {
      "binding": "ORPROXY",
      "service": "orproxy"
    },
    {
      "binding": "AGENT-BROWSING",
      "service": "agent-browsing"
    }
  ],

  "observability": {
    "enabled": true
  },

  // ---------------------------------------------------------------------------
  // KV: shared daily neuron budget + clef decision cache.
  //
  // Both namespaces exist in the account (MEM = "Memoria", MASTER = "master
  // truths") but wrangler needs the namespace *id*, and ids are not readable
  // from here without a login. Copy each one from
  //   Dashboard → Workers & Pages → KV → Memoria / master truths
  // then uncomment this block.
  //
  // Until then the worker falls back to per-isolate memory: correct for one user,
  // but the budget resets whenever the isolate is recycled.
  //
  // "kv_namespaces": [
  //   { "binding": "MEM", "id": "<Memoria namespace id>" },
  //   { "binding": "MASTER", "id": "<master truths namespace id>" }
  // ],
  // ---------------------------------------------------------------------------

  "vars": {
    // Neurons per IP per UTC day across chat + stt + tts (free allowance is 10000).
    "DAILY_NEURONS": "8000",
    "OPENROUTER_MODEL": "google/gemini-2.5-flash",
    "OPENROUTER_STT_MODEL": "openai/whisper-large-v3"
  }
}
