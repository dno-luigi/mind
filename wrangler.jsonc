{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mind",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",

  // Frontend and API served from the same origin, so the client calls "/api/chat"
  // and there is no CORS to get wrong.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Workers AI needs no key and no id — this binding alone gives us
  // whisper, melotts, aura and the clef decision ladder.
  "ai": {
    "binding": "AI"
  },

  // Browser Rendering powers /api/shot (headless screenshots). It needs the
  // Browser Rendering entitlement on the account and bills per browser second,
  // so the route is one page, one shot, one close. BROWSER is the name this
  // account uses; the code also accepts MYBROWSER (Cloudflare's docs name).
  "browser": {
    "binding": "BROWSER"
  },

  // Already exists in this account (r2-explorer-bucket). Enabling it turns on
  // /api/upload, /f/:id and the TTS mp3 cache.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "r2-explorer-bucket"
    }
  ],

  // Service bindings. A deploy sets bindings from this file, so anything added in
  // the dashboard and not declared here is deleted by the next push — that is how
  // ezxhibitz lost an R2 binding ninety minutes after it was added. Every binding
  // the account already deploys is therefore listed below, in the shape it deploys.
  //
  // TRUTH is the separate worker the standalone admin writes to: the binding
  // exposes its /api/truth/* routes here, so the first cache check asks it the
  // same question the console asks. The eight after it are not read by the code
  // yet; they are declared so a deploy stops removing them.
  "unsafe": {
    "bindings": [
      // The agent-browsing worker: ABROWSER is this account's name for it,
      // AGENT-BROWSING is the older spelling the code also accepts. This is the
      // reading half — the rendering half is BROWSER above, and they are not
      // interchangeable: a service binding cannot launch puppeteer.
      {
        "name": "ABROWSER",
        "type": "service",
        "service": "agent-browsing",
        "environment": "production"
      },
      {
        "name": "AGENT-BROWSING",
        "type": "service",
        "service": "agent-browsing",
        "environment": "production"
      },
      {
        "name": "TRUTH",
        "type": "service",
        "service": "truth",
        "environment": "production",
        "entrypoint": "default"
      },
      // The rest of the worker-to-worker graph, as the dashboard has it. Nothing
      // in src/ calls env.CODS, env.EZXHIBITZ, env.OPENCODE, env.PI, env.TEW,
      // env['TRUTH-ENGINE'], env.VIBE or env.WATCHER today; declaring them keeps
      // the deployed set stable and makes the dependency visible. Deleting any of
      // these targets makes this worker refuse to deploy until its line is gone.
      {
        "name": "CODS",
        "type": "service",
        "service": "cods",
        "environment": "production"
      },
      {
        "name": "EZXHIBITZ",
        "type": "service",
        "service": "ezxhibitz",
        "environment": "production"
      },
      {
        "name": "OPENCODE",
        "type": "service",
        "service": "opencode-harness-example",
        "environment": "production",
        "entrypoint": "default"
      },
      {
        "name": "PI",
        "type": "service",
        "service": "pi-harness-example",
        "environment": "production",
        "entrypoint": "default"
      },
      {
        "name": "TEW",
        "type": "service",
        "service": "tew",
        "environment": "production",
        "entrypoint": "default"
      },
      {
        "name": "TRUTH-ENGINE",
        "type": "service",
        "service": "truth-engine",
        "environment": "production"
      },
      {
        "name": "VIBE",
        "type": "service",
        "service": "vibe-microsite-builder",
        "environment": "production"
      },
      {
        "name": "WATCHER",
        "type": "service",
        "service": "sbcounty-probe",
        "environment": "production"
      }
    ]
  },

  // Login state. One Durable Object per user name gives sessions a single
  // home that survives isolates and reads its own writes. The migration tag is
  // a one-time record: leave it alone or Wrangler refuses the deploy.
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "Sessions"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sessions"]
    }
  ],

  "observability": {
    "enabled": true
  },

  // KV: shared daily neuron budget + clef decision cache, so neither resets
  // when an isolate is recycled. A namespace id is an identifier, not a
  // credential, so it is safe to version.
  "kv_namespaces": [
    {
      "binding": "MEM",
      "id": "4a9bfbffb4d440cba86badc508e2045a"
    },
    {
      "binding": "MASTER",
      "id": "904eff3af4c14f06964e4f651cce9573"
    }
  ],

  // The Truth Engine Prompt is a secret with an owner, so it lives in the
  // account's Secrets Store instead of this repo: TEP is the binding the code
  // reads, TRUTH_ENGINE_PROMPT is the entry it resolves to. Values never pass
  // through git, this file or a deploy log, and rewriting the prompt is a store
  // edit rather than a release. Code reads it as `await env.TEP.get()` — one
  // string, no name argument — and falls back to the preset's built-in prompt
  // if the store cannot answer.
  "secrets_store_secrets": [
    {
      "binding": "TEP",
      "store_id": "7073bd5852014f83875874ae3ff0817e",
      "secret_name": "TRUTH_ENGINE_PROMPT"
    }
  ],

  // Empty to match the deployed Worker. Every value this block used to carry is
  // also the code default — 8000 neurons/IP/day in budget.js, gemini-2.5-flash
  // and whisper-large-v3 in providers/openrouter.js — so nothing changes, and
  // the dashboard stops reporting drift on each deploy.
  "vars": {}
}
