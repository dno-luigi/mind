{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mind",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",

  // Frontend and API served from the same origin, so the client calls "/api/chat"
  // and there is no CORS to get wrong.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Workers AI needs no key and no id — this binding alone gives us
  // whisper, melotts, aura and the clef decision ladder.
  "ai": {
    "binding": "AI"
  },

  // Already exists in this account (r2-explorer-bucket). Enabling it turns on
  // /api/upload, /f/:id and the TTS mp3 cache.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "r2-explorer-bucket"
    }
  ],

  // TRUTH is the separate worker the standalone admin writes to. The binding
  // exposes its /api/truth/* routes here, so the first cache check asks it the
  // same question the console asks; AGENT-BROWSING is a browsing tool this app
  // does not use. Declared in the shape the account already deploys.
  "unsafe": {
    "bindings": [
      {
        "name": "AGENT-BROWSING",
        "type": "service",
        "service": "agent-browsing",
        "environment": "production"
      },
      {
        "name": "TRUTH",
        "type": "service",
        "service": "truth",
        "environment": "production",
        "entrypoint": "default"
      }
    ]
  },

  "observability": {
    "enabled": true
  },

  // KV: shared daily neuron budget + clef decision cache, so neither resets
  // when an isolate is recycled. A namespace id is an identifier, not a
  // credential, so it is safe to version.
  "kv_namespaces": [
    {
      "binding": "MEM",
      "id": "4a9bfbffb4d440cba86badc508e2045a"
    },
    {
      "binding": "MASTER",
      "id": "904eff3af4c14f06964e4f651cce9573"
    }
  ],

  // Empty to match the deployed Worker. Every value this block used to carry is
  // also the code default — 8000 neurons/IP/day in budget.js, gemini-2.5-flash
  // and whisper-large-v3 in providers/openrouter.js — so nothing changes, and
  // the dashboard stops reporting drift on each deploy.
  "vars": {}
}
